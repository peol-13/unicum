# Copia in keystore.properties (ignorato da git) per firmare la release.
# Il keystore va tenuto fuori dal repository e salvato in un posto sicuro:
# senza lo stesso keystore non si possono pubblicare aggiornamenti dell'app.
storeFile=C:/percorso/unicum-release.jks
storePassword=
keyAlias=unicum
keyPassword=
