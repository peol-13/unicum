<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2x1 del deficit di oggi: etichetta e obiettivo, valore, linea del deficit -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="6dp"
    android:paddingEnd="14dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/wd_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="1"
            android:text="Deficit"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/wd_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_regular"
            android:maxLines="1"
            android:textColor="@color/widget_text_muted"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/wd_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="– kcal"
        android:textColor="@color/widget_primary"
        android:textSize="19sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="14dp"
        android:layout_marginTop="4dp">

        <ImageView
            android:id="@+id/wd_line"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />

        <ImageView
            android:id="@+id/wd_marker"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitXY" />
    </FrameLayout>
</LinearLayout>
